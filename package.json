{
  "name": "hell-fire",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "author": "devils_call",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest",
    "test:run": "vitest run",
    "preview": "vite preview",
    "quantize": "node scripts/quantize-palette.cjs",
    "server": "tsx server/index.ts",
    "server:build": "tsc -p server/tsconfig.json",
    "build:all": "npm run build && npm run server:build",
    "start": "node server/dist/index.js",
    "dev:all": "concurrently -n game,server -c blue,magenta \"npm:dev\" \"npm:server\"",
    "cap:sync": "cap sync android",
    "cap:open": "cap open android",
    "apk:build": "npm run build && cap sync android && cd android && gradlew.bat assembleDebug",
    "apk:open": "npm run build && cap open android"
  },
  "dependencies": {
    "@capacitor/android": "^6.0.0",
    "@capacitor/core": "^6.0.0",
    "phaser": "^3.80.1",
    "phaser3-rex-plugins": "^1.80.17",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^6.0.0",
    "@types/ws": "^8.5.12",
    "concurrently": "^9.1.0",
    "sharp": "^0.34.5",
    "tsx": "^4.19.2",
    "typescript": "^5.3.3",
    "vite": "^5.4.11",
    "vitest": "^2.1.0"
  }
}
