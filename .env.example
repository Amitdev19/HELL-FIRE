# Optional build-time override for the co-op relay URL.
#
# Leave this EMPTY for normal hosting: when the game is served by the combined
# server (npm start), it automatically connects back to the relay on the same
# origin, so public multiplayer works with zero config.
#
# Only set this if you run the game on one host and the relay on a DIFFERENT
# host, e.g. for a dedicated private relay:
#   VITE_SERVER_URL=wss://my-private-relay.example.com
VITE_SERVER_URL=
